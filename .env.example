# EmailJS credentials (https://www.emailjs.com/)
# 1) Copy this file to .env
# 2) Paste real IDs from EmailJS Account / Email Services / Email Templates
# 3) Restart the dev server after saving (.env is only read on start)
#
# Template variables used by this site:
# {{from_name}} {{from_email}} {{to_name}} {{message}} {{reply_to}}

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
